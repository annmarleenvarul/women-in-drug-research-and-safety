# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# --- Warehouse (PostgreSQL) ---
# Inside Docker the host is the service name; from your laptop it is localhost.
WAREHOUSE_HOST=postgres
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=change_me

# Superuser for the Postgres container (creates the warehouse database on first start)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_too

# --- dbt ---
DBT_PROFILES_DIR=/opt/airflow/dbt

# --- openFDA ---
# Optional but recommended: without a key the rate limit is far lower.
# Request one at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# --- Airflow ---
AIRFLOW_UID=50000
